{
  "name": "oauth-integration",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "build": " tsc",
    "start": "nodemon --exec \"npx ts-node\" dist/index.ts",
    "dev": "nodemon --watch './**/*.ts' --exec \"npx ts-node\" dist/index.ts",
    "knex": "knex",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:test": "NODE_ENV=test npm run migrate",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "migrate:reset": "knex --knexfile knexfile.ts migrate:rollback --all && knex --knexfile knexfile.ts migrate:latest",
    "build:knex": "tsc knexfile.ts --module commonjs --esModuleInterop --outDir dist",
    "seed": "knex seed:run",
    "test": "cross-env NODE_ENV=test jest --testTimeout=10000"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "knex": "^3.3.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.22.0",
    "sqlite3": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^2.0.12",
    "cross-env": "^7.0.3",
    "jest": "^29.6.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2"
  }
}
